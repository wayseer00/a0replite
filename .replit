modules = ["nodejs-24", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "postgresql", "rustc"]

[userenv]

[userenv.shared]
OPENAI_API_STYLE = "responses"
OPENAI_MODEL_ROOT = "gpt-5.4"
OPENAI_MODEL_GATE = "gpt-5.4"
OPENAI_MODEL_WORKER = "gpt-5.4-mini"
OPENAI_MODEL_CLASSIFIER = "gpt-5.4-nano"
OPENAI_MODEL_DEEP = "gpt-5.4-pro"
OPENAI_STORE = "false"
